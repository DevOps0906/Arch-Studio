{
  "name": "@arch-studio/rules",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./dev-packs/2026.10.0.json": "./packs/2026.10.0/pack.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:golden": "node --test src/golden.test.ts",
    "golden:update": "node ../../scripts/rule-packs/update-golden.ts",
    "bench": "node ../../scripts/rule-packs/bench-judge.ts",
    "manifest": "node ../../scripts/rule-packs/manifest.ts",
    "test:golden:envelope": "node --test src/envelope/golden.test.ts",
    "golden:envelope:update": "node src/envelope/update-golden.mjs",
    "bench:envelope": "node src/envelope/bench.mjs"
  },
  "dependencies": {
    "@arch-studio/domain": "workspace:*",
    "@arch-studio/geometry": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
