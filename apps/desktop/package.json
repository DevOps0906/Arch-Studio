{
  "name": "@arch-studio/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --mode web",
    "check:release": "node scripts/check-release-bundle.mjs dist",
    "check:web": "node scripts/check-web-dist.mjs",
    "tauri": "tauri",
    "lint": "eslint src scripts vite.config.ts env-allowlist.ts env-allowlist.test.ts web-hosting.ts web-hosting.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test env-allowlist.test.ts web-hosting.test.ts \"src/workers/*.test.ts\" \"src/shell/*.test.ts\" \"src/web/*.test.ts\""
  },
  "dependencies": {
    "@arch-studio/domain": "workspace:*",
    "@arch-studio/drafting": "workspace:*",
    "@arch-studio/features": "workspace:*",
    "@arch-studio/geometry": "workspace:*",
    "@arch-studio/massing": "workspace:*",
    "@arch-studio/rules": "workspace:*",
    "@arch-studio/shell-bridge": "workspace:*",
    "@arch-studio/ui": "workspace:*",
    "manifold-3d": "3.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router": "8.5.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  }
}
