{
  "name": "arch-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter ./apps/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:db",
    "db:convert": "node scripts/db/convert.mjs --write",
    "db:convert:check": "node scripts/db/convert.mjs",
    "db:check": "node scripts/db/check.mjs",
    "db:types": "node scripts/db/gen-types.mjs",
    "test:db": "node --test scripts/db/convert.test.mjs"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.2.12",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
