# 이름만 적는다. 값은 .env.local(커밋 금지) 또는 배포 환경에 넣는다. 근거: docs/file/03-설계/02_ARCHITECTURE.md 8절·9.3절
# [필수] = 없으면 기동 실패

# --- apps/web 공개(브라우저 번들에 들어감) ---
NEXT_PUBLIC_SUPABASE_URL=            # [필수]
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # [필수]
NEXT_PUBLIC_TOSS_CLIENT_KEY=         # [필수]
NEXT_PUBLIC_HERO3D_ENABLED=          # 기본 true
NEXT_PUBLIC_HERO_VIDEO_ENABLED=      # 기본 true

# --- apps/web 서버 전용 ---
SUPABASE_SERVICE_ROLE_KEY=           # [필수]
SUPABASE_DB_SCHEMA=                  # [필수] core | public
APP_URL=                             # [필수]
TOSS_SECRET_KEY=                     # [필수]
TOSS_WEBHOOK_SECRET=                 # [필수]
LICENSE_SIGNING_PRIVATE_KEY=         # [필수]
LICENSE_SIGNING_KID=                 # [필수]
SITE_LOOKUP_HASH_KEY=                # [필수]
AI_TOKEN_PRIVATE_KEY=                # [필수]
AI_TOKEN_KID=                        # [필수]
ARCH_WORKER_INTERNAL_KEY=            # [필수]
OSS_VOICE_BASE_URL=                  # [필수]
AI_CROSS_BORDER_NOTICE_VERSION=      # [필수]
VOICE_NOTICE_VERSION=                # [필수]
ARCH_RECORDING_NOTICE_VERSION=       # [필수]
RATE_LIMIT_IP_SALT=                  # [필수]
DESKTOP_CORS_ORIGINS=                # 없으면 데스크톱 CORS 거부
VWORLD_API_KEY=                      # 없으면 대지 조회 AR021
AI_SERVICE_URL=                      # 없으면 AI 기능 오류 표시
DIFY_API_URL=
DIFY_APP_KEY_ARCH=
DIFY_USER_HMAC_SECRET=
ELEVENLABS_API_KEY=

# --- 인증 단계(9.3절) ---
AUTH_MODE=                           # 기본 live
AUTH_PROVIDERS=                      # live에서 0개면 기동 실패 (예: google,email)
DEV_SEED_PASSWORD=                   # mock 모드에서 필수
